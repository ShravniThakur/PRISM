# --- Layer 1: Authentication Engine ---
# SQLAlchemy database URL (defaults to a local SQLite file)
DATABASE_URL=sqlite:///./prism_auth.db

# Fuzzy-hash verification thresholds (defaults shown)
TEXT_TLSH_MAX_DIFF=60
IMAGE_PHASH_MAX_HAMMING=10
VIDEO_FRAME_MAX_HAMMING=12
VIDEO_MIN_MATCH_RATIO=0.9
VIDEO_SAMPLE_FPS=1.0

# --- Layer 3: Orchestration Engine ---
# PostgreSQL connection string (required in production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Full base URLs of sibling microservices.
# IMPORTANT: Do NOT use $PORT or shell variables here — they are NOT expanded by Render.
# Set the full deployed URL (e.g. https://prism-layer2.onrender.com)
LAYER1_URL=http://localhost:8000
LAYER2_URL=http://localhost:8001

# Google OAuth Client ID (required for login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT signing secret (change this in production!)
JWT_SECRET=super_secret_jwt_key_for_prism_development

# Resend API key for threat report emails
RESEND_API_KEY=re_your_api_key

# Sender address for threat report emails.
# Must use a domain verified at https://resend.com/domains for production.
# The sandbox default (onboarding@resend.dev) only delivers to your own Resend account email.
RESEND_FROM_EMAIL=PRISM Analysis <noreply@yourdomain.com>
